# Panel and probe scratch files. `.cases_*.json` are per-run stress/timing case
# lists written next to the remotion root because stress.mjs resolves paths from
# there; `.panel_*.json` are single-preview case files. All are deleted on the
# happy path, so these entries only matter when a run is interrupted.
remotion/.cases_*.json
remotion/.panel_*.json
remotion/.registry*.json
remotion/.registry_parity.cjs
remotion/.dump.cjs
remotion/scripts/.registry_parity_dump.ts

# Downloaded 3D models: regenerated by msf/providers/model_provider.py
assets/models/
remotion/public/models/

# Remotion build output (207+ PNG stress-test renders, 12 MB — regenerated)
remotion/out/

# Panel cache: preview PNGs/MP4s, voice samples, run logs
.output/
output/_panel_cache/
remotion/public/preview/

